{"repo": {"timestamp": 1771876074000, "version": 20002, "name": "HydraMeshnet", "icon": "icon.png", "address": "https://hydrameshnet.github.io/fdroid/repo", "description": "Official F-Droid repository for HydraMeshnet apps. Add this repo to your F-Droid client to receive updates."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "HydraMeshnet", "categories": ["Communication, Finance"], "suggestedVersionName": "0.2.9", "description": "\u0126Communicator is the world's first & only blackout-resilient radio meshnet ecosystem messenger and most feature-rich modular all-in-one community app for communication, commerce, payments, telephony & more, that you can use to build free market societies in crisis regions and beyond. The \u0126Communicator is the platform for the new autonomous Free World Meshnet Society & Economy. It is built entirely on the Free World Dollar (FWD), the only debt- and inflation-free digital real money system, the world will ever need.\n", "issueTracker": "https://github.com/HydraMeshnet/hcommunicator/issues", "license": "Unknown", "sourceCode": "https://github.com/HydraMeshnet/hcommunicator", "summary": "\u0126Communicator", "webSite": "https://hydramesh.net", "added": 1771875905000, "packageName": "net.hydramesh.hcommunicator", "lastUpdated": 1771875905000, "localized": {"en-US": {"icon": "icon_b8_iXl_2-DbnKCMKGCsHkr1maCl_pO3SGJ0ltwv6D5o=.png", "name": "\u0126Communicator"}}}, {"authorName": "HydraMeshnet", "categories": ["Finance"], "suggestedVersionName": "0.2.9", "description": "The world's first & only blackout-resilient cryptocurrency wallet, that can run in an energy-autonomous radio meshnet. The \u0126Wallet will soon offer Blackout-Resilience as a Service (BRaaS) (with our \u0126MESH utility coin as fee) for other blockchain ecosystems such as Bitcoin, Ethereum, USD-stablecoins, ERC20 token, etc. in order to make these cryptocurrencies usable in crisis areas with power outages for the first time. The \u0126Wallet already hosts the Presale of our HMESH ERC20 token and the \u0126Shop for our hardware products. In the future it will also host the HMESH DEX, after being implemented on our own \u0126MESH-L1.\n", "issueTracker": "https://github.com/HydraMeshnet/hwallet/issues", "license": "Unknown", "sourceCode": "https://github.com/HydraMeshnet/hwallet", "summary": "\u0126Wallet", "webSite": "https://hydramesh.net", "added": 1771876071000, "packageName": "net.hydramesh.hwallet", "lastUpdated": 1771876071000, "localized": {"en-US": {"icon": "icon_QMqHv1Uy1N7AudBP8KpdMdOWv7NxkNqFsmuk06E_ldw=.png", "name": "\u0126Wallet"}}}], "packages": {"net.hydramesh.hcommunicator": [{"added": 1771875905000, "apkName": "hcommunicator-0.2.9.apk", "features": ["android.hardware.usb.host"], "hash": "df2db8fe438cdefe222f6cf1caeb2511c52d74b6ea2ba835ce7a3fb588856d44", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "net.hydramesh.hcommunicator", "sig": "1627c426100c2d5e243dd128ff257d04", "signer": "66443797e7ec86585f74386538e6e21d3058b639e8dd87dc48ca48374df2123b", "size": 194308873, "targetSdkVersion": 33, "uses-permission": [["android.permission.READ_EXTERNAL_STORAGE", null], ["android.permission.WRITE_EXTERNAL_STORAGE", null], ["android.permission.MANAGE_EXTERNAL_STORAGE", null], ["android.permission.BLUETOOTH", 30], ["android.permission.BLUETOOTH_ADMIN", 30], ["android.permission.INTERNET", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.WAKE_LOCK", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.CHANGE_WIFI_MULTICAST_STATE", null], ["android.permission.BLUETOOTH_CONNECT", null], ["android.permission.BLUETOOTH_SCAN", null], ["android.permission.BLUETOOTH_ADVERTISE", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.READ_EXTERNAL_STORAGE", null], ["android.permission.WRITE_EXTERNAL_STORAGE", null], ["android.permission.MANAGE_EXTERNAL_STORAGE", nu